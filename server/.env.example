# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Transport
DAILY_API_KEY=your_daily_api_key_here
DAILY_ROOM_URL=  # Optional: leave empty to create a new room

# Vapi (Voice AI Platform)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# STT (Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GOOGLE_CLOUD_SPEECH_CREDENTIALS=  # Path to Google Cloud service account JSON

# LLM (Language Models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-2025-04-14
ANTHROPIC_API_KEY=  # For Claude

# TTS (Text-to-Speech)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=  # Optional: defaults to "71a7ad14-091c-4e8e-a314-022ece01c121"
GOOGLE_CLOUD_TTS_CREDENTIALS=  # Path to Google Cloud service account JSON
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=c9tXABmaj4sESRRQ4Uqo
